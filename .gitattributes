# Normalise to LF in the repository *and* in the working tree: the tree this
# tool rewrites is formatter-owned, and mixed endings show up as whole-file
# diffs in every later review.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

*.png   binary
*.jpg   binary
*.zip   binary
*.whl   binary
